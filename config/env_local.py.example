# 复制为 config/env_local.py（该文件已被 gitignore，勿提交）后填入本机真实值。
# env_local 只放密钥与真实 host；项目多出来的数据源别名请提交到 config/env_overlay.py。
# type 可写 mysql / sqlserver / postgres；不写则沿用 env.py / env_overlay 的 type。
#
# 多套环境：把每套 url+db+account 放进 ENVIRONMENTS，用下面任一方式激活一套：
#   python -m packages.config use dev          # 写入 config/.active_env（仓库全局）
#   set ARGON_ENV=uat                          # 仅当前进程，不改指针
#   ACTIVE_ENV = "dev"                         # 尚未 use 过时的默认
# 只要 ENVIRONMENTS 非空，就只套用激活那一套（忽略本文件顶层 DATABASES / TEST_*）。

ACTIVE_ENV = "dev"

ENVIRONMENTS = {
    "dev": {
        "DATABASES": {
            "main": {
                "host": "127.0.0.1",
                "port": 3306,
                "user": "root",
                "password": "CHANGE_ME",
                "database": "example",
            },
        },
        "TEST_BASE_URL": "http://127.0.0.1:8080",
        "TEST_ACCOUNT": {
            "username": "admin",
            "password": "CHANGE_ME",
        },
    },
    "uat": {
        "DATABASES": {
            "main": {
                "host": "127.0.0.1",
                "port": 3306,
                "user": "root",
                "password": "CHANGE_ME",
                "database": "example_uat",
            },
        },
        "TEST_BASE_URL": "http://127.0.0.1:8081",
        "TEST_ACCOUNT": {
            "username": "admin",
            "password": "CHANGE_ME",
        },
    },
    # PostgreSQL 示例（Plane 本地：宿主机 127.0.0.1:5432，不要用容器名 plane-db）：
    # "plane": {
    #     "DATABASES": {
    #         "main": {
    #             "type": "postgres",
    #             "host": "127.0.0.1",
    #             "port": 5432,
    #             "user": "plane",
    #             "password": "CHANGE_ME",
    #             "database": "plane",
    #         },
    #     },
    #     "TEST_BASE_URL": "http://localhost:8000",
    #     "TEST_ACCOUNT": {"username": "CHANGE_ME", "password": "CHANGE_ME"},
    # },
}

# 无 ENVIRONMENTS 时可用旧扁平写法（与上面二选一即可）：
