# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv-win
.ci_venv

# pytest cache
.pytest_cache/

# pdf files
*.pdf

# report files (legacy path; new runs use artifacts/)
report/

# run-scope artifacts (sanitized, still local) — `**/` so dogfood/ and nested workspaces are covered
**/artifacts/evidence/
**/artifacts/catalogs/
**/artifacts/inbox/
**/artifacts/runs/
**/artifacts/reports/
**/artifacts/exports/
**/artifacts/playwright/

# Local SUT login for LLM explore — never commit
**/data/**/*.local.yaml
**/data/**/*.local.json
**/data/**/*.local.md

# run-scope logs produced by supports/logging
logs/

# playwright mcp
.playwright-mcp/

# temporary agent scratch (exploration scripts, probe logs)
.agent/
# but keep tracked skills subfolder
!.agent/skills/
!.agent/skills/**

# Local secrets / machine overlay — never commit (any branch, including sandbox)
.env
.env.*
!.env.example
**/config/env_local.py
**/config/.active_env

# personal notes kept beside the repo, never committed
docs/*.local.md

# DNA overlay pointer written by tuner-dna sync (project-local)
.tuner-dna-version

# Wheel-only copy of .cursor/docs/spec/git-hooks; editable installs read the source tree
tuner_testkit/apps/dna/dna_payload/
